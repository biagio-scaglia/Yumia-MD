document "Next-Gen Cloud Architecture"
  theme "terminal"
  author "DevOps & Platform Engineering"
  aspectRatio "16:9"
  transition "wipe"
  watermark "PROD // CLUSTER-01"

slide "Kubernetes Multi-Region Mesh"
  heading "Global Edge Ingress & Microservices"
  text "Zero-trust service mesh routing with eBPF observability and auto-scaling."
  badge "v2.4 LTS" variant="success"
  notes
    Introduce our multi-region distributed cloud infrastructure deployment.

slide "Platform Architecture Pipeline"
  grid columns=3 gap=20
    card title="Edge Gateway" variant="primary"
      icon "lucide:globe" size=32 color="#10B981"
      text "Global Anycast DNS with TLS termination and DDoS mitigation."

    card title="Service Mesh" variant="accent"
      icon "lucide:cpu" size=32 color="#F59E0B"
      text "Envoy proxy sidecars with mTLS authentication and tracing."

    card title="Storage Engine" variant="success"
      icon "lucide:database" size=32 color="#06B6D4"
      text "Distributed Raft consensus with persistent NVMe replication."

slide "Observability & Performance SLAs"
  stack direction="horizontal" gap=16
    metric "99.999%" label="Core Mesh Uptime" diff="+0.009%" variant="success"
    metric "0.45ms" label="P99 Route Latency" diff="-35%" variant="primary"
    metric "12.4M" label="RPS Peak Throughput" diff="+240%" variant="accent"

slide "IaC Deployment Script"
  code lang="typescript" highlight="3-5"
    import { Cluster, Region } from '@yumia/cloud-infra';

    export const productionMesh = new Cluster('global-mesh', {
      regions: [Region.EU_CENTRAL, Region.US_EAST, Region.AP_SOUTHEAST],
      replicasPerRegion: 12,
      ebpfMonitoring: true,
    });

slide "Core Engineering Philosophy"
  quote author="Site Reliability Engineering Handbook"
    Hope is not a strategy. Reliability is the fundamental feature of any scalable platform.
