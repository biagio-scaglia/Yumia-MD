{
  "name": "yumia-md",
  "version": "0.1.21",
  "private": true,
  "description": "A Markdown-based presentation language and compiler designed for humans and AI",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "version:bump": "node scripts/bump-version.mjs",
    "publish:packages": "pnpm -r publish --access public --no-git-checks",
    "release": "node scripts/release.mjs",
    "dev": "node packages/cli/dist/bin.js dev",
    "yumia": "node packages/cli/dist/bin.js",
    "yumiamd": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "author": "Biagio Scaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/Yumia-MD.git"
  },
  "homepage": "https://github.com/biagio-scaglia/Yumia-MD#readme",
  "bugs": {
    "url": "https://github.com/biagio-scaglia/Yumia-MD/issues"
  }
}
