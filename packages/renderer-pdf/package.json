{
  "name": "@yumiamd/renderer-pdf",
  "version": "0.1.4",
  "description": "PDF renderer placeholder for YumiaMD presentations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@yumiamd/ast": "workspace:*",
    "@yumiamd/renderer": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yumia",
    "presentation",
    "pdf",
    "renderer"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/Yumia-MD.git"
  },
  "homepage": "https://github.com/biagio-scaglia/Yumia-MD#readme",
  "bugs": {
    "url": "https://github.com/biagio-scaglia/Yumia-MD/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
