{
  "name": "@yumia/core",
  "version": "0.1.0",
  "description": "Core orchestration and compiler pipeline for YumiaMD presentations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@yumia/ast": "workspace:*",
    "@yumia/layout": "workspace:*",
    "@yumia/parser": "workspace:*",
    "@yumia/renderer": "workspace:*",
    "@yumia/theme": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yumia",
    "presentation",
    "core",
    "compiler"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT"
}
