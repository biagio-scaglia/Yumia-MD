{
  "name": "@yumiamd/core",
  "version": "0.1.7",
  "private": true,
  "description": "Core orchestration and compiler pipeline for YumiaMD presentations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@yumiamd/ast": "workspace:*",
    "@yumiamd/layout": "workspace:*",
    "@yumiamd/parser": "workspace:*",
    "@yumiamd/renderer": "workspace:*",
    "@yumiamd/theme": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yumia",
    "presentation",
    "core",
    "compiler"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/Yumia-MD.git"
  },
  "homepage": "https://github.com/biagio-scaglia/Yumia-MD#readme",
  "bugs": {
    "url": "https://github.com/biagio-scaglia/Yumia-MD/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
