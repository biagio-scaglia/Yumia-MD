{
  "name": "yumiamd",
  "version": "0.1.6",
  "description": "Command line interface and compiler for YumiaMD presentations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yumia": "./dist/bin.js",
    "yumiamd": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@yumiamd/ast": "workspace:*",
    "@yumiamd/core": "workspace:*",
    "@yumiamd/layout": "workspace:*",
    "@yumiamd/parser": "workspace:*",
    "@yumiamd/renderer": "workspace:*",
    "@yumiamd/renderer-pptx": "workspace:*",
    "@yumiamd/theme": "workspace:*",
    "tsup": "^8.5.1"
  },
  "scripts": {
    "build": "tsup src/bin.ts src/index.ts --format esm --dts --clean --external pptxgenjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "yumia",
    "presentation",
    "cli"
  ],
  "author": "Biagio Scaglia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biagio-scaglia/Yumia-MD.git"
  },
  "homepage": "https://github.com/biagio-scaglia/Yumia-MD#readme",
  "bugs": {
    "url": "https://github.com/biagio-scaglia/Yumia-MD/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
