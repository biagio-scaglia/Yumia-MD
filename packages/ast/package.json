{
  "name": "@biagioscaglia/yumia-ast",
  "version": "0.1.3",
  "description": "Semantic AST data structures for YumiaMD presentations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
